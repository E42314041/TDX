{
    "name": "TDX Ubuntu Environment",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
    
    "features": {
        "ghcr.io/devcontainers/features/common:1": {},
        "ghcr.io/devcontainers/features/git:1": {}
    },
    
    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y qemu-system-x86 build-essential git python3 python3-pip lsb-release && echo '✅ 环境准备完成！'",
    
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.makefile-tools",
                "ms-python.python"
            ]
        }
    },
    
    "forwardPorts": [8080],
    "remoteUser": "vscode"
}
